# 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다.
# 로드 방식: node --env-file=.env (dotenv 미사용)
#
# 설정은 세 층이다 (#59, ADR-0015): 스키마 기본값 → pm-jude.config.json → 환경변수.
# 정착된 설정은 pm-jude.config.json(예시: pm-jude.config.example.json, 실파일은 커밋 금지)에,
# 일회성 실행 주입(PMJUDE_FAKE_BACKEND=1 pnpm dev 류)만 환경변수로 두는 것을 권장한다.
# 환경변수가 항상 최종 우선이다. 파일 위치는 PMJUDE_CONFIG로 바꿀 수 있다.

# Claude Agent SDK 백엔드 (F14). 미설정 시 게이트웨이 백엔드 생성이 실패한다.
ANTHROPIC_API_KEY=

# 세션 저장소 SQLite 파일 경로 (ADR-0006)
PMJUDE_DB_PATH=./data/pm-jude.db

# 첨부 원본 저장소 (F1-Attach, ADR-0011) — 내용 주소(sha256) 기반. 삭제 경로 없음:
# 보존 기간이 정해지면 그때 일괄 정리한다 (PRD §12-20).
PMJUDE_ATTACHMENTS_PATH=./data/attachments

# LLM 게이트웨이 폭주 방지 상한 (PRD §6 비용 가드레일)
PMJUDE_LLM_TIMEOUT_MS=120000
PMJUDE_LLM_MAX_CONCURRENCY=2

# 웹 러너 (#16, ADR-0007) — 로컬 단일 프로세스, 루프백 바인딩. pnpm web
PMJUDE_WEB_PORT=8787
# 웹 UI (#22, ADR-0008) — pnpm dev (API+UI 동시) 또는 pnpm web:ui (UI만)
# PMJUDE_API_URL=http://127.0.0.1:8787
# 다른 기기에서 UI를 열 때 — Next 16이 루프백 밖 origin의 dev 리소스를 403으로 막는다.
# 열려는 호스트를 쉼표로 나열한다 (미설정이면 localhost만 허용 — 기본은 차단 유지).
# 남에게 보여주는 용도라면 pnpm demo(빌드된 UI)가 낫다 — 이 검사도 HMR 소켓도 없다.
# PMJUDE_DEV_ORIGINS=172.20.11.245
# pnpm demo의 UI 포트 (기본 3000)
# PMJUDE_UI_PORT=3000
# UI 개발·데모용 가짜 백엔드 — LLM 자격 증명 없이 결정론적 시나리오 (별도 DB 사용)
# PMJUDE_FAKE_BACKEND=1

# Slack PoC 러너 (#8) — Socket Mode. 앱 생성·토큰 발급은 운영자 작업. 후순위 (ADR-0007).
# Bot Token Scopes: app_mentions:read, chat:write, channels:history, groups:history, im:history
# Event Subscriptions: app_mention, message.channels (Socket Mode 활성화 필수)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# 팀 표준 문서 언어 (F2d) / 명확화 왕복 상한 (수치는 PoC 중 확정)
PMJUDE_TEAM_LANGUAGE=ko
PMJUDE_MAX_ROUNDS=3

# Linear 개인 API 키 — 이슈 생성(F6, #69)과 소급 아카이브 분석(#9)이 함께 쓴다.
# 키와 팀 ID가 둘 다 있어야 실이슈가 생성되고, 없으면 페이크 커넥터(FAKE-n)로 루프가 돈다.
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# 노션 커넥터 (#57, ADR-0013) — 내부 통합(connection) 토큰 (ntn_ 접두사).
# 발급은 Workspace Owner: Developer portal → Internal connections. 읽을 페이지는
# 노션에서 ••• → 연결(Connections)에 통합을 공유해야 한다. 미설정이면 커넥터 꺼짐 —
# 노션 URL은 텍스트로 남는다. 상세: docs/research/notion-api.md
NOTION_API_KEY=
