# 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다.
# 로드 방식: node --env-file=.env (dotenv 미사용)

# Claude Agent SDK 백엔드 (F14). 미설정 시 게이트웨이 백엔드 생성이 실패한다.
ANTHROPIC_API_KEY=

# 세션 저장소 SQLite 파일 경로 (ADR-0006)
PMJUDE_DB_PATH=./data/pm-jude.db

# LLM 게이트웨이 폭주 방지 상한 (PRD §6 비용 가드레일)
PMJUDE_LLM_TIMEOUT_MS=120000
PMJUDE_LLM_MAX_CONCURRENCY=2

# Slack PoC 러너 (#8) — Socket Mode. 앱 생성·토큰 발급은 운영자 작업.
# Bot Token Scopes: app_mentions:read, chat:write, channels:history, groups:history, im:history
# Event Subscriptions: app_mention, message.channels (Socket Mode 활성화 필수)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# 팀 표준 문서 언어 (F2d) / 명확화 왕복 상한 (수치는 PoC 중 확정)
PMJUDE_TEAM_LANGUAGE=ko
PMJUDE_MAX_ROUNDS=3
